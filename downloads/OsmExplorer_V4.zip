</div>
<script>let isDragging=false;let startX;let scrollLeft;async function fetchSponsoredProducts(){try{const response=await fetch('/fetch_sponsoredproducts_banner.php');if(!response.ok){throw new Error('Request failed with status: '+response.status);}const products=await response.json();let anchura=displaySponsoredProducts(products);const iframeContainerDer=document.getElementById('myIframeDer');if(window.innerWidth>1279){iframeContainerDer.style.width=(window.innerWidth-400)+"px";}else{iframeContainerDer.style.width=(window.innerWidth-100)+"px";}if(anchura>(window.innerWidth-400)){document.getElementById("izq").style.display="block";document.getElementById("der").style.display="block";}else{document.getElementById("sponsored-products").style.marginLeft="0px";document.getElementById("sponsored-products-ads").style.marginLeft="10px";}}catch(error){console.error(error.message);let anchura=0;}}
function displaySponsoredProducts(products){const container=document.getElementById('sponsored-products');container.innerHTML='';anchura=140;products.forEach(product=>{anchura=anchura+142;const productDiv=document.createElement('div');productDiv.className='sponsored-product';const link=document.createElement('a');link.href=product.link;link.target='_blank';link.style.textDecoration='none';const img=document.createElement('img');img.src=product.image;link.appendChild(img);const title=document.createElement('div');title.className='sponsored-product-title';title.textContent=product.title;link.appendChild(title);const price=document.createElement('div');price.className='sponsored-product-price';price.textContent=product.price;link.appendChild(price);productDiv.appendChild(link);container.appendChild(productDiv);});return anchura;}function scrollLeftX(){const container=document.getElementById('sponsored-products');container.scrollBy({left:-250,behavior:'smooth'});}function scrollRight(){const container=document.getElementById('sponsored-products');container.scrollBy({left:250,behavior:'smooth'});}function startDrag(e){isDragging=true;startX=e.pageX||e.touches[0].pageX;scrollLeft=document.getElementById('sponsored-products').scrollLeft;}function endDrag(){isDragging=false;}function drag(e){if(!isDragging)return;e.preventDefault();const x=e.pageX||e.touches[0].pageX;const walk=(x-startX)*1.5;document.getElementById('sponsored-products').scrollLeft=scrollLeft-walk;}</script>
<script>fetchSponsoredProducts();</script>
