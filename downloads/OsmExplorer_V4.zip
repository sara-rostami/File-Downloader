<div id=myIframeDer style="width:100%;margin:auto">
<div class=bodygallery>
<div id=sponsored-products-ads style="width:100%;float:left;margin:0 0 0 10px">
<span class=sponsored-label id=adx style="display:none;background:#fff">Ad</span>
</div>
<div class=gallery-container id=galleryx>
<button class="arrow arrow-left" style=display:none id=izq onclick="scrollLeftX()">❮</button>
<div class=sponsored-products id=sponsored-products onmousedown="startDrag(event)" onmouseup="endDrag()" onmouseleave="endDrag()" onmousemove="drag(event)" ontouchstart="startDrag(event)" ontouchend="endDrag()" ontouchmove="drag(event)"></div>
<button class="arrow arrow-right" style=display:none id=der onclick="scrollRight()">❯</button>
</div>
</div>
</div>
